<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <!--
      Транскодирование UTF-8 без аллокаций на netstandard2.0 делается только
      через Encoding.GetString(byte*, int): span-перегрузок там нет, а
      ToArray() на каждой строке - ровно та аллокация, ради отсутствия
      которой всё и затевалось.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- едет внутри пакета JsonGoddess, своего пакета у него нет -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Span, ArrayPool и Utf8Parser на netstandard2.0 живут в отдельных пакетах;
    на net8.0+ они в самом рантайме.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Buffers" Version="4.5.1" />
    <PackageReference Include="System.Memory" Version="4.5.5" />
  </ItemGroup>

  <!--
    Труба нужна потоковому читателю (JsonStreamReader). Сама сборка
    System.IO.Pipelines.dll лежит в общем рантайме начиная с .NET Core 3.0, но
    в наборе ссылок библиотеки её нет, поэтому пакет приходится назвать явно;
    для framework-dependent приложения он не добавляет ни одного файла к
    поставке. На netstandard2.0 потокового читателя нет вовсе - там он стоил бы
    настоящей лишней зависимости.
  -->
  <ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <PackageReference Include="System.IO.Pipelines" Version="8.0.0" />
  </ItemGroup>

</Project>
