<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Один таргет, и это не экономия: здесь проверяется текст, который
      генератор печатает, и диагностики, которые он выдаёт. Ни то, ни другое не
      зависит от рантайма, на котором исполнится результат. Многотаргетность
      нужна там, где исполняются #else-ветки, - в JsonGoddess.Tests.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Корпус System.Text.Json вендорится как ДАННЫЕ, а не как исходники: он
      уезжает в CSharpGeneratorDriver текстом, вместе с хостом, который мы
      печатаем сами. Компилироваться в эту сборку он не должен и не может -
      половина его типов существует именно для того, чтобы наш генератор от
      них отказался, а отказ генератора здесь ошибка компиляции.
    -->
    <Compile Remove="Stj\corpus\**" />
    <None Include="Stj\corpus\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Update, а не Include: .md уже подобран стандартным глобом None -->
    <None Update="Stj\PINNED.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Генератор здесь - обычная ссылка на сборку, а не анализатор: тесты
      запускают его руками через CSharpGeneratorDriver, чтобы видеть и шаги
      конвейера, и отвергнутые компиляции, которые анализатором просто сломали
      бы сборку тестов.
    -->
    <ProjectReference Include="..\JsonGoddess.Generator\JsonGoddess.Generator.csproj" />
    <ProjectReference Include="..\JsonGoddess.Common\JsonGoddess.Common.csproj" />
    <ProjectReference Include="..\JsonGoddess.Components\JsonGoddess.Components.csproj" />

    <!--
      Фасад нужен не как зависимость тестов, а как ссылка ДЛЯ проверяемой
      компиляции: перехват вызовов (§10) срабатывает только тогда, когда тип
      JsonGoddess.Compat.JsonSerializer в ней вообще есть.
    -->
    <ProjectReference Include="..\JsonGoddess.Compat\JsonGoddess.Compat.csproj" />
  </ItemGroup>

</Project>
