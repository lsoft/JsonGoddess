<Project>

  <!--
    Перехват вызовов фасада (§10, маршрут A) включён по умолчанию: тот, кто
    сослался на JsonGoddess.Compat, именно за этим и сослался.

    Выключается в csproj потребителя:

      <PropertyGroup>
        <JsonGoddessCompat>disable</JsonGoddessCompat>
      </PropertyGroup>

    Свойство обязано быть видимо компилятору, иначе генератор его не прочтёт:
    CompilerVisibleProperty ниже - не украшение, а единственный способ довезти
    значение из MSBuild в анализатор.
  -->
  <PropertyGroup Condition="'$(JsonGoddessCompat)' == ''">
    <JsonGoddessCompat>enable</JsonGoddessCompat>
  </PropertyGroup>

  <!--
    Громкость отступления. Тип, который обслужить нельзя, уходит эталону и
    продолжает работать - это объявленное поведение, и по умолчанию о нём
    сообщается подсказкой (JGD001, severity Info). Проекту, которому важно,
    чтобы ускорилось ВСЁ, этого мало:

      <PropertyGroup>
        <JsonGoddessCompatStrict>warning</JsonGoddessCompatStrict>
      </PropertyGroup>

    Значения: info (умолчание), warning, error. Свойство меняет только
    громкость: решение - уйти эталону - остаётся тем же, и собирается проект
    ровно так же. Умолчания здесь нет намеренно: пустое значение и есть
    "ничего не менять", а выставь мы info явно, отличить "не просили" от
    "просили умолчание" стало бы нечем.
  -->
  <!--
    Веб-профиль моста (§10, маршрут B). ASP.NET Core строит опции не по
    умолчаниям, а по JsonSerializerDefaults.Web - camelCase, имена без учёта
    регистра, число можно строкой, - и под такие опции нужен ОТДЕЛЬНЫЙ
    порождённый код: имена свойств преобразуются на компиляции, подменить их в
    рантайме нечем.

      <PropertyGroup>
        <JsonGoddessCompatWeb>enable</JsonGoddessCompatWeb>
      </PropertyGroup>

    По умолчанию выключено, и это не осторожность, а арифметика: веб-вариант -
    это второй писатель и второй читатель на каждый обслуженный тип.
    Консольному приложению он не нужен ни разу, а веб-проекту нужен всегда, и
    узнаёт он о свойстве из сообщения, которое мост печатает, отступая:
    догадываться за человека, сколько кода ему напечатать, нечем.
  -->
  <ItemGroup>
    <CompilerVisibleProperty Include="JsonGoddessCompat" />
    <CompilerVisibleProperty Include="JsonGoddessCompatStrict" />
    <CompilerVisibleProperty Include="JsonGoddessCompatWeb" />
  </ItemGroup>

</Project>
