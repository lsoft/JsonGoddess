<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Те же три таргета, что у JsonGoddess.Tests, и по той же причине: net472
      здесь единственный, кто исполняет netstandard2.0-сборку фасада, и
      единственный, у кого в BCL нет ModuleInitializerAttribute - то есть
      единственный, кто проверяет полифилл, который генератор печатает сам.
    -->
    <TargetFrameworks>net472;net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!--
      Перехват включён - в отличие от JsonGoddess.Tests. Свойство пишется
      явно, а не берётся умолчанием: смысл этого проекта в том, что перехват
      работает, и читателю csproj это должно быть видно.
    -->
    <JsonGoddessCompat>enable</JsonGoddessCompat>

    <!--
      Веб-профиль моста. Без значения его включает сам факт ссылки на
      ASP.NET Core, а этот проект на него не ссылается и не должен: он проверяет
      порождённый код, а не конвейер. Поэтому здесь свойство стои́т явно - ровно
      тот случай, ради которого оно и оставлено.

      Что веб-профиль появляется САМ там, где ссылка есть, проверяет
      JsonGoddess.WebPerformanceTests: он не ставит этого свойства вовсе.
    -->
    <JsonGoddessCompatWeb>enable</JsonGoddessCompatWeb>

    <!--
      JGD004 здесь - ожидаемый результат, а не помеха. Tricky объявляет член с
      кириллическим именем, веб-профиль включает регистронезависимый матч, а он
      такое имя отвергает (JGD030): эталон свернул бы регистр по Unicode, мы -
      по ASCII, и совпадение зависело бы от алфавита. Диагностика об этом и
      говорит, и молчать ей нельзя.

      Заглушается только здесь и только потому, что проверяется тестом
      The_web_profile_refuses_a_non_ascii_member_name - то есть утверждение не
      исчезает, а переезжает туда, где его видно.
    -->
    <NoWarn>$(NoWarn);JGD004</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="JsonGoddessCompat" />
    <CompilerVisibleProperty Include="JsonGoddessCompatWeb" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472' Or '$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JsonGoddess.Common\JsonGoddess.Common.csproj" />
    <ProjectReference Include="..\JsonGoddess.Components\JsonGoddess.Components.csproj" />
    <ProjectReference Include="..\JsonGoddess.Compat\JsonGoddess.Compat.csproj" />

    <ProjectReference Include="..\JsonGoddess.Generator\JsonGoddess.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>


  <ItemGroup>
    <!--
      Культура прогона из JSONGODDESS_TEST_CULTURE - один файл на все тестовые
      проекты. Генератор работает на сборке, и его культура - тоже культура
      машины, так что вопрос стоит здесь ровно так же, как и в рантайме.
    -->
    <Compile Include="..\JsonGoddess.Tests\TestCulture.cs" Link="Shared\TestCulture.cs" />
  </ItemGroup>

</Project>
