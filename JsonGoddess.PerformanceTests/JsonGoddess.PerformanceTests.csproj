<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net472;net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      BenchmarkDotNet собирает и запускает свои проекты; в Debug измерять
      нечего, поэтому сам прогон всегда идёт в Release.
    -->
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JsonGoddess.Common\JsonGoddess.Common.csproj" />
    <ProjectReference Include="..\JsonGoddess.Components\JsonGoddess.Components.csproj" />

    <!--
      Генератор подключён анализатором, как у потребителя пакета: мерить надо
      тот код, который получит человек, а не его рукописный эквивалент.
    -->
    <ProjectReference Include="..\JsonGoddess.Generator\JsonGoddess.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
